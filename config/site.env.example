# =============================================================================
# Site configuration template.
#
# Do NOT edit this file for a real site. Generate a per-site copy instead:
#
#   bin/new-site example.com
#
# That creates sites/example.com.env (mode 600, gitignored) with strong random
# passwords already filled in. This template is the only committed copy and it
# must never contain a real credential.
# =============================================================================

# --- Site -------------------------------------------------------------------
SITE_DOMAIN="example.com"          # Canonical domain. Drives every derived name.
SITE_TITLE="My WordPress Site"     # Site title.
SITE_LOCALE="en_US"                # WordPress locale, e.g. es_ES / en_US.
WP_VERSION="latest"                # "latest" or a pinned version, e.g. 6.7.2.

# --- Paths ------------------------------------------------------------------
WP_PATH="/apps/wordpress/example.com/html"   # Absolute document root.
SSL_DIR="/apps/ssl/example.com"              # server.crt / server.key live here.

# --- WordPress administrator ------------------------------------------------
WP_ADMIN_USER="wp_admin"
WP_ADMIN_EMAIL="admin@example.com"
WP_ADMIN_PASSWORD="CHANGEME"       # Generated by bin/new-site.

# --- Database (dedicated user, created by bin/install-wordpress) ------------
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="wp_example"
DB_USER="wp_example"
DB_PASSWORD="CHANGEME"             # Generated by bin/new-site.

# --- Web stack --------------------------------------------------------------
PHP_VERSION="8.3"

# Nginx layout, depending on where nginx came from:
#   nginxorg -> installed from nginx.org (1.30.x): /etc/nginx/conf.d/*.conf
#   ubuntu   -> installed from Ubuntu repos (1.24.x): sites-available + symlink
NGINX_MODE="nginxorg"

# --- Optional overrides -----------------------------------------------------
# Uncomment only to override the derived defaults.
# NGINX_SITE_NAME="example-com"                    # default: domain, dots -> dashes
# PHP_FPM_SOCK="/run/php/php8.3-fpm.sock"          # default: from PHP_VERSION
# CLIENT_MAX_BODY_SIZE="64M"                       # keep in sync with php.ini
# WEB_USER="www-data"
# WEB_GROUP="www-data"
