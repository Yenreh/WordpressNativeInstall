# =============================================================================
# Site configuration template.
#
# Do NOT edit this file for a real site. Generate a per-site copy instead:
#
#   bin/new-site example.com
#
# That creates sites/example.com.env (mode 600, gitignored) with strong random
# passwords already filled in. This template is the only committed copy and it
# must never contain a real credential.
# =============================================================================

# --- Site -------------------------------------------------------------------
SITE_DOMAIN="example.com"          # Canonical domain. Drives every derived name.
SITE_TITLE="My WordPress Site"     # Site title.
SITE_LOCALE="en_US"                # WordPress locale, e.g. es_ES / en_US.
WP_VERSION="latest"                # "latest" or a pinned version, e.g. 6.7.2.

# --- Paths ------------------------------------------------------------------
WP_PATH="/apps/wordpress/example.com/html"   # Absolute document root.
SSL_DIR="/apps/ssl/example.com"              # server.crt / server.key live here.

# --- WordPress administrator ------------------------------------------------
WP_ADMIN_USER="wp_admin"
WP_ADMIN_EMAIL="admin@example.com"
WP_ADMIN_PASSWORD="CHANGEME"       # Generated by bin/new-site.

# --- Database (dedicated user, created by bin/install-wordpress) ------------
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="wp_example"
DB_USER="wp_example"
DB_PASSWORD="CHANGEME"             # Generated by bin/new-site.

# Table prefix, applied by the installer through `wp config create --dbprefix`.
# bin/new-site randomizes it per site (wp_xxxx_). It only deflects canned
# payloads that hardcode wp_, so treat it as hygiene, not as a defence. It must
# be decided BEFORE installing: changing it later means renaming every table and
# fixing the *_user_roles and *_capabilities keys.
DB_TABLE_PREFIX="wp_"

# --- Web stack --------------------------------------------------------------
PHP_VERSION="8.3"

# Nginx layout, depending on where nginx came from:
#   nginxorg -> installed from nginx.org (1.30.x): /etc/nginx/conf.d/*.conf
#   ubuntu   -> installed from Ubuntu repos (1.24.x): sites-available + symlink
NGINX_MODE="nginxorg"

# --- Development stack (bin/dev, Docker only) -------------------------------
# Used exclusively by `bash bin/dev`. The production installer ignores them.
# All of them are optional: the defaults below are what gets derived.
#
# The database is EXTERNAL: bin/dev starts no database container. It reuses
# DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD above.
#
# Dev and production use opposite database models on purpose:
#   production - one dedicated user per database, created by the installer.
#   dev        - one connection account reused across every local site, allowed
#                to create databases, so adding a site creates no user.
# Hence bin/dev creates a missing database itself; set this to "false" to
# require it to exist beforehand.
# DEV_DB_AUTOCREATE="true"
DEV_HTTP_PORT="8080"               # Host port. Use a distinct one per site.
# DEV_BIND_ADDR="127.0.0.1"        # 0.0.0.0 to expose the stack to the LAN.
# DEV_URL="http://localhost:8080"  # Default: http://localhost:${DEV_HTTP_PORT}
# DEV_WP_IMAGE="wordpress:php8.3-apache"   # Default: from PHP_VERSION
# DEV_PROJECT_NAME="wpdev-example-com"     # Compose project name

# Database host as seen FROM the container. Derived from DB_HOST: a loopback
# value becomes host.docker.internal, anything else is used as is. Override
# only when the container must reach the server through another address.
# DEV_DB_HOST="192.168.1.50"

# Table prefix for the dev install. Defaults to DB_TABLE_PREFIX; set it only
# when dev and production share a database and the tables must stay apart.
# DEV_TABLE_PREFIX="wpdev_"

# Where the WordPress files land in dev. bin/new-site writes an absolute path
# here (dev/<domain>/html inside the repo, gitignored) so the files are visible
# and editable from the host — the containers run as your uid. Remove the line
# to keep the document root inside a Docker named volume instead.
# DEV_DOCROOT="/home/user/dev/example.com/html"

# Colon-separated absolute paths mounted into wp-content/plugins and
# wp-content/themes — the practical way to develop a plugin against this stack.
# DEV_PLUGIN_DIRS="/home/user/GIT/my-plugin:/home/user/GIT/other-plugin"
# DEV_THEME_DIRS="/home/user/GIT/my-theme"

# --- Optional overrides -----------------------------------------------------
# Uncomment only to override the derived defaults.
# NGINX_SITE_NAME="example-com"                    # default: domain, dots -> dashes
# PHP_FPM_SOCK="/run/php/php8.3 -fpm.sock"          # default: from PHP_VERSION
# CLIENT_MAX_BODY_SIZE="64M"                       # keep in sync with php.ini
# WEB_USER="www-data"
# WEB_GROUP="www-data"
