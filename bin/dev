#!/usr/bin/env bash
# =============================================================================
# dev - Local development stack for a site, running WordPress in Docker.
#
# The host needs no PHP and no nginx: WordPress and WP-CLI run in containers.
# The DATABASE IS EXTERNAL — no database container is started; the connection
# details come from the site config and the database must already exist.
# Production installs still use bin/install-wordpress.
#
# Usage:
#   bash bin/dev [--config sites/<domain>.env] <command> [args]
#
# Commands:
#   up [--no-install]  Start the stack and install WordPress if needed
#   stop               Stop the container (everything preserved)
#   restart            Restart the container
#   down [--volumes]   Remove container and network. --volumes also deletes the
#                      WordPress files volume; the external database is never touched
#   status             Container state, database reachability, WordPress status
#   logs [service]     Follow the logs (default: wordpress)
#   wp <args>          Run WP-CLI, e.g. `dev wp plugin list`
#   shell [service]    Open a shell in a container (default: wordpress)
#   url                Print the local URL
#   db-dump [file]     Dump the database into backups/
#
# Requires Docker with the Compose v2 plugin (`docker compose`).
# =============================================================================
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "${REPO_ROOT}/lib/common.sh"
# shellcheck source=../lib/config.sh
source "${REPO_ROOT}/lib/config.sh"

COMPOSE_FILE="${REPO_ROOT}/docker/compose.dev.yml"

usage() { print_usage "$0"; }

CONFIG_ARG=""
NO_SUDO=false
ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)   usage; exit 0 ;;
        -c|--config) CONFIG_ARG="$2"; shift 2 ;;
        -y|--yes)    ASSUME_YES=true; shift ;;
        --no-sudo)   NO_SUDO=true; shift ;;
        --)          shift; ARGS+=("$@"); break ;;
        *)           ARGS+=("$1"); shift ;;
    esac
done

[ ${#ARGS[@]} -gt 0 ] || { usage; exit 1; }
COMMAND="${ARGS[0]}"
ARGS=("${ARGS[@]:1}")

SITE_CONFIG_PATH="$(resolve_site_config "$CONFIG_ARG")" || exit 1
load_site_config "$SITE_CONFIG_PATH"

# -----------------------------------------------------------------------------
# Docker plumbing
# -----------------------------------------------------------------------------
DOCKER_PREFIX=()

require_docker() {
    command -v docker >/dev/null 2>&1 \
        || die "Docker is not installed. See https://docs.docker.com/engine/install/"

    if docker info >/dev/null 2>&1; then
        DOCKER_PREFIX=()
    elif [ "$NO_SUDO" != true ] && command -v sudo >/dev/null 2>&1; then
        # Typical when the user is not in the `docker` group; sudo may prompt.
        DOCKER_PREFIX=(sudo)
        sudo docker info >/dev/null 2>&1 \
            || die "Cannot reach the Docker daemon, even with sudo. Is it running?"
        info "Using sudo for Docker (user is not in the 'docker' group)."
    else
        die "Cannot reach the Docker daemon. Add your user to the 'docker' group or drop --no-sudo."
    fi

    "${DOCKER_PREFIX[@]}" docker compose version >/dev/null 2>&1 \
        || die "Docker Compose v2 is required (the 'docker compose' plugin)."
}

# Extra bind mounts for plugins/themes under development are expressed as a
# generated override file, because Compose cannot build a dynamic volume list.
write_override() {
    local dir="${DEV_STATE_DIR}"
    mkdir -p "$dir"
    # Hand the state directory to the real user right away: under sudo it would
    # otherwise stay root-owned, and this runs even when no override is written.
    chown "${DEV_UID}:${DEV_GID}" "$dir" "$(dirname "$dir")" 2>/dev/null || true
    local file="${dir}/compose.override.yml"

    local entries=()
    local path name

    local IFS=':'
    for path in ${DEV_PLUGIN_DIRS:-}; do
        [ -n "$path" ] || continue
        [ -d "$path" ] || die "DEV_PLUGIN_DIRS entry is not a directory: $path"
        name="$(basename "$path")"
        entries+=("      - ${path}:/var/www/html/wp-content/plugins/${name}")
    done
    for path in ${DEV_THEME_DIRS:-}; do
        [ -n "$path" ] || continue
        [ -d "$path" ] || die "DEV_THEME_DIRS entry is not a directory: $path"
        name="$(basename "$path")"
        entries+=("      - ${path}:/var/www/html/wp-content/themes/${name}")
    done
    unset IFS

    if [ ${#entries[@]} -eq 0 ]; then
        rm -f "$file"
        OVERRIDE_ARGS=()
        return 0
    fi

    {
        echo "# Generated by bin/dev from DEV_PLUGIN_DIRS / DEV_THEME_DIRS."
        echo "# Do not edit: it is rewritten on every command."
        echo "services:"
        echo "  wordpress:"
        echo "    volumes:"
        printf '%s\n' "${entries[@]}"
        echo "  cli:"
        echo "    volumes:"
        printf '%s\n' "${entries[@]}"
    } > "$file"

    # Under sudo this would otherwise leave root-owned files inside the repo,
    # which the user can no longer edit or delete.
    chown -R "${DEV_UID}:${DEV_GID}" "$dir" 2>/dev/null || true

    OVERRIDE_ARGS=(-f "$file")
}

COMPOSE_EXTRA=()

compose() {
    export DB_NAME DB_USER DB_PASSWORD DB_PORT
    export DEV_DB_HOST DEV_TABLE_PREFIX
    export DEV_WP_IMAGE DEV_CLI_IMAGE
    export DEV_BIND_ADDR DEV_HTTP_PORT DEV_URL DEV_WP_SOURCE
    export DEV_UID DEV_GID
    "${DOCKER_PREFIX[@]}" docker compose \
        ${COMPOSE_EXTRA[@]+"${COMPOSE_EXTRA[@]}"} \
        -p "$DEV_PROJECT_NAME" \
        -f "$COMPOSE_FILE" \
        "${OVERRIDE_ARGS[@]}" \
        "$@"
}

wp_cli() {
    # `wp` is passed explicitly: the image entrypoint only prepends it when it
    # recognizes the first argument as a wp-cli subcommand, and that detection
    # is unreliable (it fails with "exec: db: not found" for `db check`).
    # `--progress quiet` keeps the per-run container chatter out of the output.
    # shellcheck disable=SC2034  # read by compose() through dynamic scoping
    local -a COMPOSE_EXTRA=(--progress quiet)
    compose --profile cli run --rm -T cli wp "$@"
}

# -----------------------------------------------------------------------------
# Commands
# -----------------------------------------------------------------------------
cmd_up() {
    local do_install=true
    local arg
    for arg in "$@"; do
        [ "$arg" = "--no-install" ] && do_install=false
    done

    # Bind-mounted docroot: create it up front and hand it to the real user,
    # otherwise running under sudo would leave a root-owned directory.
    if [ -n "${DEV_DOCROOT:-}" ]; then
        mkdir -p "$DEV_DOCROOT"
        chown "${DEV_UID}:${DEV_GID}" "$DEV_DOCROOT" 2>/dev/null || true
        info "Bind-mounted document root: ${DEV_DOCROOT} (owner ${DEV_UID}:${DEV_GID})"
    fi

    step "Starting the development stack (${DEV_PROJECT_NAME})"
    info "External database: ${DEV_DB_HOST}:${DB_PORT}/${DB_NAME} (user ${DB_USER})"
    compose up -d
    ok "Container started"

    step "Waiting for WordPress core files"
    local i
    for i in $(seq 1 60); do
        if compose exec -T wordpress test -f /var/www/html/wp-load.php 2>/dev/null; then
            ok "Core files ready"
            break
        fi
        [ "$i" -eq 60 ] && die "WordPress did not initialize. Check: bash bin/dev logs"
        sleep 2
    done

    step "Checking database connectivity from the container"
    local check_output create_output
    if check_output="$(wp_cli db check 2>&1)"; then
        ok "Connected to ${DB_NAME} at ${DEV_DB_HOST}:${DB_PORT}"
    elif [ "$DEV_DB_AUTOCREATE" = true ] && create_output="$(wp_cli db create 2>&1)"; then
        # The connection account is allowed to create databases, which is the
        # whole point of sharing one account across dev sites.
        ok "Database ${DB_NAME} did not exist and was created"
        if check_output="$(wp_cli db check 2>&1)"; then
            ok "Connected to ${DB_NAME} at ${DEV_DB_HOST}:${DB_PORT}"
        else
            err "The database was created but the check still fails:"
            printf '      %s\n' "$check_output"
            die "Database unusable."
        fi
    else
        err "The database check failed. Reported error:"
        echo ""
        printf '      %s\n' "$check_output"
        echo ""
        if [ "$DEV_DB_AUTOCREATE" = true ]; then
            info "Creating ${DB_NAME} automatically also failed:"
            printf '      %s\n' "${create_output:-<no output>}"
            echo ""
        else
            info "DEV_DB_AUTOCREATE is disabled, so the database was not created for you."
            echo ""
        fi

        # Separate a network problem from an authentication/permission one.
        info "Probing the TCP port from inside the container..."
        if compose exec -T wordpress php -r \
            "\$f = @fsockopen('${DEV_DB_HOST}', ${DB_PORT}, \$e, \$s, 5);
             echo \$f ? 'reachable' : 'unreachable: ' . \$s;" 2>/dev/null | grep -q reachable
        then
            ok "${DEV_DB_HOST}:${DB_PORT} is reachable from the container — so this is not a network problem."
            echo ""
            echo "    Then it is the credentials or the grants of '${DB_USER}'."
            echo "    Dev expects one connection account reused across sites, allowed to"
            echo "    create its databases. Scope it to the wp_ prefix rather than *.*:"
            echo "      GRANT ALL PRIVILEGES ON \`wp\\_%\`.* TO '${DB_USER}'@'%';"
            echo ""
            echo "    Otherwise create the database by hand and set DEV_DB_AUTOCREATE=\"false\":"
            echo "      CREATE DATABASE \`${DB_NAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
            echo "      GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.* TO '${DB_USER}'@'%';"
            echo ""
            echo "    A grant limited to 'localhost' never covers the container."
        else
            err "${DEV_DB_HOST}:${DB_PORT} is NOT reachable from the container — this is a network problem."
            echo ""
            echo "      - MariaDB must not bind to 127.0.0.1 only (bind-address in the server config)."
            echo "      - A firewall may be blocking the Docker bridge subnet."
            echo "      - Set DEV_DB_HOST in the site config if the server needs another address."
        fi
        echo ""
        die "Database unreachable."
    fi

    if [ "$do_install" = true ]; then
        step "Checking the WordPress installation"
        if wp_cli core is-installed >/dev/null 2>&1; then
            ok "WordPress is already installed"
        else
            info "Running the installer..."
            wp_cli core install \
                --url="$DEV_URL" \
                --title="${SITE_TITLE} (dev)" \
                --admin_user="$WP_ADMIN_USER" \
                --admin_password="$WP_ADMIN_PASSWORD" \
                --admin_email="$WP_ADMIN_EMAIL" \
                --skip-email
            wp_cli rewrite structure '/%postname%/' >/dev/null 2>&1 || true
            ok "WordPress installed"
        fi
    fi

    echo ""
    echo "  ${C_GREEN}Site:${C_NC}  ${DEV_URL}"
    echo "  ${C_GREEN}Admin:${C_NC} ${DEV_URL}/wp-admin  (user: ${WP_ADMIN_USER})"
    echo "  ${C_BLUE}Credentials are in ${SITE_CONFIG_FILE}${C_NC}"
    echo ""
}

cmd_stop() {
    compose stop
    ok "Containers stopped (data preserved)"
}

cmd_restart() {
    compose restart
    ok "Containers restarted"
}

cmd_down() {
    local wipe=false
    local arg
    for arg in "$@"; do
        [ "$arg" = "--volumes" ] && wipe=true
    done

    if [ "$wipe" = true ]; then
        warn "This DELETES the WordPress files volume. The external database is NOT touched."
        confirm "Remove the stack and its volume?" || { info "Cancelled."; return 0; }
        compose down --volumes
        ok "Stack and volume removed (database untouched)"
    else
        compose down
        ok "Container and network removed (volume preserved)"
    fi
}

cmd_status() {
    banner "Development stack" "${SITE_DOMAIN} — ${DEV_URL}"

    section "Container"
    compose ps

    section "Database (external)"
    echo "  ${DEV_DB_HOST}:${DB_PORT}/${DB_NAME} as ${DB_USER} (prefix ${DEV_TABLE_PREFIX})"
    if wp_cli db check >/dev/null 2>&1; then
        ok "Reachable from the container"
    else
        err "Not reachable from the container"
    fi

    section "WordPress"
    if wp_cli core is-installed >/dev/null 2>&1; then
        ok "Installed — version $(wp_cli core version 2>/dev/null | tr -d '\r')"
        ok "Home: $(wp_cli option get home 2>/dev/null | tr -d '\r')"
    else
        warn "Not installed yet. Run: bash bin/dev up"
    fi

    section "Storage"
    if [ -n "${DEV_DOCROOT:-}" ]; then
        echo "  Document root (bind): ${DEV_DOCROOT}"
    else
        echo "  Document root: named volume ${DEV_PROJECT_NAME}_wp_data"
    fi
    [ -n "${DEV_PLUGIN_DIRS:-}" ] && echo "  Plugin mounts: ${DEV_PLUGIN_DIRS}"
    [ -n "${DEV_THEME_DIRS:-}" ]  && echo "  Theme mounts:  ${DEV_THEME_DIRS}"
    echo ""
}

cmd_logs() {
    local service="${1:-wordpress}"
    compose logs -f --tail=100 "$service"
}

cmd_wp() {
    [ $# -gt 0 ] || die "Usage: dev wp <wp-cli arguments>"
    wp_cli "$@"
}

cmd_shell() {
    local service="${1:-wordpress}"
    compose exec "$service" bash 2>/dev/null || compose exec "$service" sh
}

cmd_url() {
    echo "$DEV_URL"
}

cmd_db_dump() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        mkdir -p "${REPO_ROOT}/backups"
        target="${REPO_ROOT}/backups/${DB_NAME}-dev-$(date '+%Y%m%d-%H%M%S').sql"
    fi

    umask 077
    wp_cli db export - > "$target"
    ok "Dump written: ${target} ($(du -h "$target" | awk '{print $1}'))"
}

# -----------------------------------------------------------------------------
# `url` is pure configuration: it must work without Docker.
[ "$COMMAND" = "url" ] && { cmd_url; exit 0; }

OVERRIDE_ARGS=()
write_override
require_docker

case "$COMMAND" in
    up)      cmd_up "${ARGS[@]+"${ARGS[@]}"}" ;;
    stop)    cmd_stop ;;
    restart) cmd_restart ;;
    down)    cmd_down "${ARGS[@]+"${ARGS[@]}"}" ;;
    status)  cmd_status ;;
    logs)    cmd_logs "${ARGS[@]+"${ARGS[@]}"}" ;;
    wp)      cmd_wp "${ARGS[@]+"${ARGS[@]}"}" ;;
    shell)   cmd_shell "${ARGS[@]+"${ARGS[@]}"}" ;;
    url)     cmd_url ;;
    db-dump) cmd_db_dump "${ARGS[@]+"${ARGS[@]}"}" ;;
    *)       err "Unknown command: ${COMMAND}"; echo ""; usage; exit 1 ;;
esac
