#!/usr/bin/env bash
# =============================================================================
# new-site - Create a per-site configuration file from config/site.env.example.
#
# Usage:
#   bin/new-site <domain> [--title "Site title"] [--email admin@domain]
#                         [--locale es_ES] [--path /apps/wordpress/<d>/html]
#                         [--nginx-mode nginxorg|ubuntu] [--dev-port 8080]
#                         [--dev-docroot /abs/path]
#                         [--force]
#
# Writes sites/<domain>.env with mode 600 and freshly generated passwords.
# The sites/ directory is gitignored: credentials never reach the repository.
# =============================================================================
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "${REPO_ROOT}/lib/common.sh"

usage() { print_usage "$0"; }

DOMAIN=""
TITLE=""
EMAIL=""
LOCALE="en_US"
WP_PATH_ARG=""
NGINX_MODE_ARG="nginxorg"
PHP_VERSION_ARG="8.3"
DEV_PORT_ARG=""
DEV_DOCROOT_ARG=""
FORCE=false

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)     usage; exit 0 ;;
        --title)       TITLE="$2"; shift 2 ;;
        --email)       EMAIL="$2"; shift 2 ;;
        --locale)      LOCALE="$2"; shift 2 ;;
        --path)        WP_PATH_ARG="$2"; shift 2 ;;
        --nginx-mode)  NGINX_MODE_ARG="$2"; shift 2 ;;
        --php-version) PHP_VERSION_ARG="$2"; shift 2 ;;
        --dev-port)    DEV_PORT_ARG="$2"; shift 2 ;;
        --dev-docroot) DEV_DOCROOT_ARG="$2"; shift 2 ;;
        --force)       FORCE=true; shift ;;
        -*)            die "Unknown option: $1" ;;
        *)             [ -z "$DOMAIN" ] && DOMAIN="$1" || die "Unexpected argument: $1"; shift ;;
    esac
done

[ -n "$DOMAIN" ] || { usage; exit 1; }

case "$NGINX_MODE_ARG" in
    nginxorg|ubuntu) ;;
    *) die "Invalid --nginx-mode '${NGINX_MODE_ARG}'. Use 'nginxorg' or 'ubuntu'." ;;
esac

# Derived defaults.
SLUG="${DOMAIN//./_}"
SLUG="${SLUG//-/_}"
TITLE="${TITLE:-$DOMAIN}"
EMAIL="${EMAIL:-admin@${DOMAIN}}"
WP_PATH_ARG="${WP_PATH_ARG:-/apps/wordpress/${DOMAIN}/html}"
# Dev files live beside the generated compose override, under the gitignored
# dev/ directory, so everything for a local site sits in one place.
DEV_DOCROOT_ARG="${DEV_DOCROOT_ARG:-${REPO_ROOT}/dev/${DOMAIN}/html}"

# Values the scripts would derive on their own. They are written into the file
# as commented lines so every knob is visible and editable in one place.
NGINX_SITE_NAME_DEFAULT="${DOMAIN//./-}"
DEV_PROJECT_DEFAULT="wpdev-${DOMAIN//./-}"
DEV_DB_HOST_DEFAULT="host.docker.internal"   # DB_HOST below is loopback
DEV_UID_DEFAULT="${SUDO_UID:-$(id -u)}"
DEV_GID_DEFAULT="${SUDO_GID:-$(id -g)}"

# MariaDB identifiers are limited to 64 characters; keep well below that.
DB_NAME="wp_${SLUG}"
DB_USER="wp_${SLUG}"
DB_NAME="${DB_NAME:0:60}"
DB_USER="${DB_USER:0:30}"

TARGET="${REPO_ROOT}/sites/${DOMAIN}.env"

# Pick a dev port that no other site config already claims.
pick_dev_port() {
    local port="${DEV_PORT_ARG:-8080}"
    local used f
    used="$(grep -hoP '^\s*DEV_HTTP_PORT="?\K[0-9]+' "${REPO_ROOT}"/sites/*.env 2>/dev/null || true)"
    while echo "$used" | grep -qx "$port"; do
        port=$((port + 1))
    done
    echo "$port"
}
DEV_PORT="$(pick_dev_port)"

if [ -f "$TARGET" ] && [ "$FORCE" != true ]; then
    die "Config already exists: ${TARGET} (use --force to overwrite)"
fi

# A per-site table prefix. Marginal as a defence (it only sidesteps canned
# payloads that hardcode wp_), but free, and it must be decided before the
# install: changing it later means renaming every table.
TABLE_PREFIX="wp_$(generate_password 4 'a-z0-9')_"

ADMIN_PASSWORD="$(generate_password 24)"
DB_PASSWORD="$(generate_password 24)"

mkdir -p "${REPO_ROOT}/sites"
umask 077
cat > "$TARGET" <<EOF
# =============================================================================
# Site configuration for ${DOMAIN}
# Generated by bin/new-site on $(date -u '+%Y-%m-%d %H:%M:%S UTC')
#
# CONTAINS CREDENTIALS - gitignored, mode 600. Never commit or copy this file
# into the repository tree.
# =============================================================================

# --- Site ---
SITE_DOMAIN="${DOMAIN}"
SITE_TITLE="${TITLE}"
SITE_LOCALE="${LOCALE}"
WP_VERSION="latest"

# --- Paths (production) ---
WP_PATH="${WP_PATH_ARG}"
SSL_DIR="/apps/ssl/${DOMAIN}"

# --- WordPress administrator ---
WP_ADMIN_USER="wp_admin"
WP_ADMIN_EMAIL="${EMAIL}"
WP_ADMIN_PASSWORD="${ADMIN_PASSWORD}"

# --- Database ---
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="${DB_NAME}"
DB_USER="${DB_USER}"
DB_PASSWORD="${DB_PASSWORD}"

# Table prefix, applied when WordPress is installed. Randomized per site; set it
# to "wp_" if you prefer the conventional one. Cannot be changed afterwards
# without renaming the tables by hand.
DB_TABLE_PREFIX="${TABLE_PREFIX}"

# --- Web stack (production) ---
PHP_VERSION="${PHP_VERSION_ARG}"
NGINX_MODE="${NGINX_MODE_ARG}"      # nginxorg (conf.d) | ubuntu (sites-available)

# Optional, shown with the value that is derived when the line stays commented.
# NGINX_SITE_NAME="${NGINX_SITE_NAME_DEFAULT}"
# PHP_FPM_SOCK="/run/php/php${PHP_VERSION_ARG}-fpm.sock"
# CLIENT_MAX_BODY_SIZE="64M"          # keep in sync with php.ini
# WEB_USER="www-data"
# WEB_GROUP="www-data"

# =============================================================================
# Dev stack (bin/dev, Docker). Ignored by the production installer.
# The database is external here too, but one connection account is reused
# across every local site and is expected to be able to create databases.
# =============================================================================
DEV_HTTP_PORT="${DEV_PORT}"

# Where the WordPress files land in dev. They belong to your user, so you can
# edit them without sudo. Comment this out to keep them in a Docker named
# volume instead (nothing visible on the host).
DEV_DOCROOT="${DEV_DOCROOT_ARG}"

# Optional, shown with the value that is derived when the line stays commented.
# DEV_BIND_ADDR="127.0.0.1"           # 0.0.0.0 exposes the site to the LAN
# DEV_URL="http://localhost:${DEV_PORT}"
# DEV_PROJECT_NAME="${DEV_PROJECT_DEFAULT}"
# DEV_WP_IMAGE="wordpress:php${PHP_VERSION_ARG}-apache"
# DEV_CLI_IMAGE="wordpress:cli"
# DEV_DB_HOST="${DEV_DB_HOST_DEFAULT}"   # DB address as seen from the container
# DEV_TABLE_PREFIX="${TABLE_PREFIX}"  # defaults to DB_TABLE_PREFIX
# DEV_DB_AUTOCREATE="true"            # false: the database must exist beforehand
# DEV_UID="${DEV_UID_DEFAULT}"                 # identity the containers run as
# DEV_GID="${DEV_GID_DEFAULT}"

# Local directories mounted live into wp-content (colon-separated, absolute).
# DEV_PLUGIN_DIRS="/abs/path/to/plugin:/abs/path/to/another"
# DEV_THEME_DIRS="/abs/path/to/theme"
EOF
chmod 600 "$TARGET"

banner "Site config created" "${DOMAIN}"
ok "File: ${TARGET} (mode 600, gitignored)"
ok "Admin user: wp_admin — password generated (24 chars)"
ok "Database:   ${DB_NAME} / ${DB_USER} — password generated (24 chars)"
ok "Table prefix: ${TABLE_PREFIX}"
echo ""
ok "Dev port:   ${DEV_PORT} (http://localhost:${DEV_PORT})"
ok "Dev files:  ${DEV_DOCROOT_ARG}"
echo ""
info "Review the file, then either provision the host stack:"
echo "    sudo bash bin/check-prerequisites --config ${TARGET}"
echo "    sudo bash bin/install-wordpress   --config ${TARGET}"
echo ""
info "or run it locally in Docker (no PHP needed, external database):"
echo "    bash bin/dev --config ${TARGET} up"
echo ""
